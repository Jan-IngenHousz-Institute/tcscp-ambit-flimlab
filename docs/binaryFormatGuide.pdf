BT 1 0 0 1 0 461 Tm 12 TL /F4 7 Tf 0 0 0 rg (clear) Tj T*  T* (% -- Constants --) Tj T* (MAGIC = uint64\(7617148963331411170\);) Tj T*  T* (% -- File open --) Tj T* (filename = 'out.bin';) Tj T* (fileID = fopen\(filename,'r'\);) Tj T* (s = dir\(filename\);) Tj T* (filesize = s.bytes;) Tj T*  T* (% -- Read important header fields) Tj T* (if fread\(fileID,1,'uint64=) Tj (>) Tj (uint64'\) ~= MAGIC) Tj T* (    error\('Invalid input file'\)) Tj T* (end) Tj T* (header_len = fread\(fileID,1,'uint64=) Tj (>) Tj (uint64'\);) Tj T*  T* (% -- Read other header fields) Tj T* (fseek\(fileID, 0, 'bof'\);) Tj T* (header = fread\(fileID,header_len ,'uint64=) Tj (>) Tj (uint64'\);) Tj T*  T* (LSB = double\(header\(5\)\)  * 1e-15 / double\(2^header\(7\)\);) Tj T* (if header\(6\) ~= 0) Tj T* (    LSB = LSB * \(double\(2^64\) / double\(header\(6\)\)\);) Tj T* (end) Tj T*  T* (% -- Read all events) Tj T* (events_data = zeros\(\(filesize - header_len * 8\) / 9, 3, 'uint64'\);  % preallocate) Tj T*  T* (% -- Read channel data) Tj T* (fseek\(fileID, header_len * 8, 'bof'\);) Tj T* (events_data\(:,1\) = fread\(fileID,'uint8=) Tj (>) Tj (uint64', 8\);) Tj T*  T* (% -- Read timestamps data) Tj T* (fseek\(fileID, header_len * 8 + 1, 'bof'\);) Tj T* (events_data\(:,3\) = fread\(fileID,'uint64=) Tj (>) Tj (uint64', 1\);) Tj T*  T* (% -- Separate rise/fall from channel number) Tj T* (events_data\(:,2\) = bitshift\(events_data\(:,1\), -7\);) Tj T* ET
